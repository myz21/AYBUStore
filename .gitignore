# Dependency and build output
node_modules/
.next/
out/
dist/
coverage/
work/


# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Keep source and assets tracked
!.gitignore
!README.md
!src/
!src/**
!app/
!app/**
!public/
!public/**
!images/
!images/**
!_legacy/
!_legacy/**

# Keep common project configs tracked
!package.json
!package-lock.json
!pnpm-lock.yaml
!yarn.lock
!next.config.js
!next.config.mjs
!postcss.config.js
!postcss.config.mjs
!tailwind.config.js
!tailwind.config.ts
!tsconfig.json